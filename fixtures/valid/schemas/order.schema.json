{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "item_count",
    "total_cents",
    "currency",
    "note"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "maxLength": 32
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_cents": {
      "type": "integer"
    },
    "currency": {
      "type": "string",
      "maxLength": 8
    },
    "note": {
      "type": "string",
      "maxLength": 200
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}
